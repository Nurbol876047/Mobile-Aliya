<?xml version="1.0" encoding="utf-8"?>
<!-- Әдепкіде тек HTTPS. Шифрланбаған HTTP тек жергілікті әзірлеу серверіне рұқсат етілген
     (Android эмуляторы → компьютер: 10.0.2.2). Нақты телефонда өз Wi-Fi IP-іңізді осында қосыңыз
     немесе серверді HTTPS арқылы жариялаңыз. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
